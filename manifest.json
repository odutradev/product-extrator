{
  "manifest_version": 3,
  "name": "WhatsApp Chat Parser",
  "description": "Analisa grupos do WhatsApp e raspa dados de produtos",
  "version": "1.0.0",
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://meli.la/*",
    "https://*.mercadolivre.com.br/*",
    "https://*.mercadolibre.com/*",
    "https://*.amazon.com.br/*",
    "https://amzn.to/*",
    "https://*.shopee.com.br/*",
    "https://s.shopee.com.br/*"
  ],
  "action": {
    "default_title": "Abrir WhatsApp Chat Parser"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  }
}